{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  packageRules: [
    {
      // Auto-merge patch updates
      matchUpdateTypes: [
        'patch',
      ],
      automerge: true,
      automergeType: 'pr',
      automergeStrategy: 'squash',
    },
    {
      // Disable auto-updates for controller-runtime and controller-tools
      // These must be updated manually alongside crossplane-runtime due to API compatibility
      enabled: false,
      matchPackageNames: [
        '/^sigs\\.k8s\\.io/controller-runtime/',
        '/^sigs\\.k8s\\.io/controller-tools/',
      ],
    },
    {
      // Disable auto-updates for hashicorp/terraform-plugin-* packages
      // These are transitive dependencies that should update alongside terraform-provider-grafana
      enabled: false,
      matchPackageNames: [
        '/^github\\.com/hashicorp/terraform-plugin-/',
      ],
    },
    {
      // Let terraform-provider-grafana drive Grafana monorepo and Asserts client dependency updates
      enabled: false,
      matchPackageNames: [
        '/^github\\.com/grafana/grafana(/|$)/',
        '/^github\\.com/grafana/grafana-asserts-public-clients(/|$)/',
      ],
    },
    {
      // terraform-provider-grafana is updated by the update-terraform-provider
      // workflow, triggered by a repository_dispatch from upstream releases.
      // It runs make generate and opens the PR, so Renovate must not open a
      // competing one.
      enabled: false,
      matchPackageNames: [
        'github.com/grafana/terraform-provider-grafana/v4',
      ],
    },
    {
      // Other Go module updates affect the compiled binary, use fix(deps) to trigger a patch release
      matchManagers: [
        'gomod',
      ],
      semanticCommitType: 'fix',
    },
  ],
  // Grafana's global Renovate config titles vulnerability fixes as
  // "fix(security/<severity>/<cve>): ... [security]". The PR title check
  // requires scopes to match [a-z][a-z0-9_-]*, so the slashes make every
  // security PR fail and block automerge. Severity and CVE are already
  // conveyed via labels and the PR body, so use a plain "deps" scope.
  vulnerabilityAlerts: {
    semanticCommitScope: 'deps',
    commitMessageSuffix: '',
  },
}
